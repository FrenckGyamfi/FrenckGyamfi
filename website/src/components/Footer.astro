---
import content from '../data/content.json';
const { legal, slogan } = content.footer;
---
<footer class="site-footer">
  <div class="wrap">
    <div class="legal">
      <img class="foot-logo" src="images/logo-on-dark-336.webp" srcset="images/logo-on-dark-168.webp 168w, images/logo-on-dark-336.webp 336w" sizes="101px" alt="DataiTECH" width="336" height="80" loading="lazy">
      {legal.map((l) => <span set:html={l} />)}
      <a href="privacy.html">Privacy statement</a>
    </div>
    <span class="mono">{slogan}</span>
  </div>
</footer>

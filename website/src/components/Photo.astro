---
// A cropped, lazy-loaded photo from public/images/<name>-640, -960 and -1200.webp
interface Props { name: string; alt: string; w: number; h: number; pos?: string; posM?: string; class?: string; sizes?: string; }
const { name, alt, w, h, pos = 'center', posM = pos, class: cls = '', sizes = '(max-width: 1216px) calc(100vw - 40px), 1176px' } = Astro.props;
---
<figure class:list={['photo', cls]} style={`--pos:${pos};--pos-m:${posM}`}>
  <img src={`images/${name}-1200.webp`} srcset={`images/${name}-640.webp 640w, images/${name}-960.webp 960w, images/${name}-1200.webp 1200w`} sizes={sizes} alt={alt} width={w} height={h} loading="lazy" decoding="async">
</figure>

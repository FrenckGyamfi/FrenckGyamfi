---
import '../styles/global.css';
import content from '../data/content.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import siteJs from '../scripts/site.js?raw';

interface Props { title?: string; description?: string; path?: string; noindex?: boolean; }
const { meta } = content;
const { title = meta.title, description = meta.description, path = '', noindex = false } = Astro.props;
const url = meta.url + path;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <script is:inline>document.documentElement.classList.add('js')</script>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={url}>
  {noindex && <meta name="robots" content="noindex">}
  <link rel="icon" href="favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="apple-touch-icon.png">
  <meta name="theme-color" content="#0F131A">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="DataiTECH">
  <meta property="og:title" content={path ? title : meta.ogTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={url}>
  <meta property="og:image" content={meta.ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="en_GB">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preload" href="fonts/plus-jakarta-sans-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <style is:inline>
    @font-face { font-family: "Plus Jakarta Sans"; font-weight: 600; font-display: swap; src: url("fonts/plus-jakarta-sans-latin-600-normal.woff2") format("woff2"); }
    @font-face { font-family: "Plus Jakarta Sans"; font-weight: 700; font-display: swap; src: url("fonts/plus-jakarta-sans-latin-700-normal.woff2") format("woff2"); }
    @font-face { font-family: "Plus Jakarta Sans"; font-weight: 800; font-display: swap; src: url("fonts/plus-jakarta-sans-latin-800-normal.woff2") format("woff2"); }
    @font-face { font-family: "Inter"; font-weight: 400; font-display: swap; src: url("fonts/inter-latin-400-normal.woff2") format("woff2"); }
    @font-face { font-family: "Inter"; font-weight: 500; font-display: swap; src: url("fonts/inter-latin-500-normal.woff2") format("woff2"); }
    @font-face { font-family: "IBM Plex Mono"; font-weight: 400; font-display: swap; src: url("fonts/ibm-plex-mono-latin-400-normal.woff2") format("woff2"); }
    @font-face { font-family: "IBM Plex Mono"; font-weight: 500; font-display: swap; src: url("fonts/ibm-plex-mono-latin-500-normal.woff2") format("woff2"); }
  </style>
  <script type="application/ld+json" set:html={JSON.stringify(meta.jsonld)} />
</head>
<body>
  <Header />
  <main id="top">
    <slot />
  </main>
  <Footer />
  <a class="to-top" href="#top" aria-label="Back to top"><svg viewBox="0 0 18 18" fill="none" stroke-width="2"><path d="M9 15V3M4 8l5-5 5 5"/></svg></a>
  <script is:inline set:html={siteJs} />
</body>
</html>
